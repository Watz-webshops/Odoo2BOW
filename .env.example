# Database — Neon Console (aanbevolen)
# Maak project op https://console.neon.tech, copy de "Pooled connection" string,
# en plak hier (let op: postgresql+asyncpg:// in plaats van postgresql://).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/odoo2bow?sslmode=require&channel_binding=require

# Backend secrets (verplicht — minimum 32 tekens)
SECRET_KEY=change-this-to-a-random-secret-key-32-chars-min
ADMIN_JWT_SECRET=change-this-to-another-random-secret-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet encryption key voor Odoo API keys (genereer met:
# docker compose exec backend python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional
LOG_LEVEL=INFO
MAX_PARTICIPATIONS_PER_EXPORT=50000

# Lokale Postgres (alleen nodig met `docker compose --profile local-db up`)
POSTGRES_PASSWORD=changeme
POSTGRES_DB=odoo2bow
POSTGRES_USER=odoo2bow
