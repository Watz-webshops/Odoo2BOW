# PostgreSQL
POSTGRES_PASSWORD=changeme
POSTGRES_DB=odoo2bow
POSTGRES_USER=odoo2bow

# Backend
DATABASE_URL=postgresql+asyncpg://odoo2bow:changeme@db:5432/odoo2bow
SECRET_KEY=change-this-to-a-random-secret-key-32-chars-min
ADMIN_JWT_SECRET=change-this-to-another-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_SECRET=change-this-nextauth-secret

# Optional
LOG_LEVEL=INFO
MAX_PARTICIPATIONS_PER_EXPORT=50000
